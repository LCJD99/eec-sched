{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LCJD99/eec-sched/blob/main/docs/schemas/tool-call-plan-candidates.schema.json",
  "title": "EEC Scheduler Planner Candidates",
  "description": "One offline workload record containing the three device-independent DAG alternatives produced by one Planner call. The DAG definition is embedded so this schema can be validated without a network resolver.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dags"],
  "properties": {
    "trace_id": {"type": "string", "minLength": 1},
    "task_input": {"type": "object"},
    "system_state": {"type": "object"},
    "dags": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/toolCallDag"},
        {"$ref": "#/$defs/toolCallDag"},
        {"$ref": "#/$defs/toolCallDag"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "toolCallDag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "final_outputs"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/toolNode"}
        },
        "final_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/finalOutput"}
        }
      }
    },
    "toolNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "tool_id", "inputs"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "tool_id": {"$ref": "#/$defs/nonEmptyString"},
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/nonEmptyString"},
          "additionalProperties": {"$ref": "#/$defs/inputSource"}
        }
      }
    },
    "inputSource": {
      "oneOf": [
        {"$ref": "#/$defs/requestInputSource"},
        {"$ref": "#/$defs/nodeInputSource"}
      ]
    },
    "requestInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"const": "request"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "data_type": {"enum": ["audio", "image", "text"]}
      }
    },
    "nodeInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "port"],
      "properties": {
        "kind": {"const": "node"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "port": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "finalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "port"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "port": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
